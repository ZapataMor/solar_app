APP_NAME=Natalia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

WEATHER_STATION_API_URL=https://meteoestacion.desarrollougmaicao.com/api_publica.php
WEATHER_STATION_SCHEDULE_TIMEZONE=America/Bogota
METEO_API_ENDPOINT=${WEATHER_STATION_API_URL}
METEO_API_SINCE_PARAMETER=fecha_desde
METEO_API_VERIFY_SSL=false
METEO_DEVICE_CODE=METEOESTACION

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=
OPENCODE_BASE_URL=
OPENAI_REQUEST_TIMEOUT=30
OPENAI_RECOMMENDATIONS_ENABLED=false
OPENAI_RECOMMENDATIONS_MODEL=gpt-5-mini
OPENAI_RECOMMENDATIONS_PROVIDER=openai
OPENCODE_MODEL=gpt-5-mini
OPENAI_RECOMMENDATIONS_MAX_OUTPUT_TOKENS=400
OPENAI_RECOMMENDATIONS_CACHE_TTL_MINUTES=30

# ── Ambient Weather ─────────────────────────────────────────────
# Cualquier visita pone al día los datos climáticos si el programador no corre (ADR-0025).
CLIMATE_SYNC_ON_TRAFFIC=true

AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
AMBIENT_ENABLED=true
AMBIENT_REQUEST_TIMEOUT=20
AMBIENT_CACHE_MINUTES=10
AMBIENT_BASE_URL=https://api.ambientweather.net/v1
# On Windows PHP/cURL, download cacert.pem and point this to its absolute path.
# Example: AMBIENT_CA_BUNDLE=C:\tools\php84\extras\ssl\cacert.pem
AMBIENT_CA_BUNDLE=
AMBIENT_VERIFY_SSL=true
AMBIENT_ONLINE_THRESHOLD_MINUTES=30

# Heartbeat monitor (Healthchecks.io, Better Stack…): the scheduler pings this URL every minute.
# Leave empty to skip it. It alerts by email or Telegram when the pings stop (ADR-0016).
HEARTBEAT_PING_URL=
